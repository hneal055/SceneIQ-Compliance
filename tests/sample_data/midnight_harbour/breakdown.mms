<?xml version="1.0" encoding="UTF-8"?>
<!-- =============================================================================
     tests/sample_data/midnight_harbour/breakdown.mms
     Sample Movie Magic Scheduling export — Midnight Harbour (small noir).
     6 scenes covering harbor + precinct in a single jurisdiction.
     Tests: DAWN/DUSK timecodes, page-half-counts (0.125, 0.5, 0.75),
     no-cast inserts, small-cast scenes.
     ============================================================================= -->
<BreakdownBook title="Midnight Harbour" production="SceneIQ Demo Productions">

  <BreakdownSheet>
    <SceneNumber>1</SceneNumber>
    <Description>Cold open; wide on the docks</Description>
    <SceneHeading>EXT. HARBOUR DOCKS - DAWN</SceneHeading>
    <SetName>HARBOUR DOCKS</SetName>
    <PageCount>2.0</PageCount>
    <ElementList>MARSH, ROOKIE</ElementList>
    <ShootDay>Georgia</ShootDay>
    <ProductionNote>Crane down to body</ProductionNote>
  </BreakdownSheet>

  <BreakdownSheet>
    <SceneNumber>2</SceneNumber>
    <Description>Establish the team; DISPATCH on radio</Description>
    <SceneHeading>INT. POLICE PRECINCT - DAY</SceneHeading>
    <SetName>POLICE PRECINCT</SetName>
    <PageCount>1.5</PageCount>
    <ElementList>MARSH, ROOKIE, CAPTAIN HOLT, DISPATCH</ElementList>
    <ShootDay>Georgia</ShootDay>
    <ProductionNote>Tight on the board</ProductionNote>
  </BreakdownSheet>

  <BreakdownSheet>
    <SceneNumber>3</SceneNumber>
    <Description>Two-hander; witness is evasive</Description>
    <SceneHeading>EXT. HARBOUR MASTER OFFICE - DAY</SceneHeading>
    <SetName>HARBOUR MASTER OFFICE</SetName>
    <PageCount>1.0</PageCount>
    <ElementList>MARSH, HARBOUR MASTER</ElementList>
    <ShootDay>Georgia</ShootDay>
    <ProductionNote>Profile coverage</ProductionNote>
  </BreakdownSheet>

  <BreakdownSheet>
    <SceneNumber>4</SceneNumber>
    <Description>Pickup; close on a ringing payphone</Description>
    <SceneHeading>INT. HARBOUR DOCKS BATHROOM - NIGHT</SceneHeading>
    <SetName>HARBOUR DOCKS BATHROOM</SetName>
    <PageCount>0.125</PageCount>
    <ElementList></ElementList>
    <ShootDay>Georgia</ShootDay>
    <ProductionNote>Insert only — no cast</ProductionNote>
  </BreakdownSheet>

  <BreakdownSheet>
    <SceneNumber>5</SceneNumber>
    <Description>Long take; suspect off-screen</Description>
    <SceneHeading>INT. POLICE PRECINCT INTERROGATION - NIGHT</SceneHeading>
    <SetName>POLICE PRECINCT INTERROGATION</SetName>
    <PageCount>2.5</PageCount>
    <ElementList>MARSH, ROOKIE</ElementList>
    <ShootDay>Georgia</ShootDay>
    <ProductionNote>Single setup</ProductionNote>
  </BreakdownSheet>

  <BreakdownSheet>
    <SceneNumber>6</SceneNumber>
    <Description>Solo reflective moment</Description>
    <SceneHeading>EXT. HARBOUR DOCKS - DUSK</SceneHeading>
    <SetName>HARBOUR DOCKS</SetName>
    <PageCount>0.75</PageCount>
    <ElementList>MARSH</ElementList>
    <ShootDay>Georgia</ShootDay>
    <ProductionNote>Magic hour</ProductionNote>
  </BreakdownSheet>

</BreakdownBook>
