<?xml version="1.0" encoding="UTF-8"?>
<!-- =============================================================================
     tests/sample_data/locked_room/breakdown.mms
     Sample Movie Magic Scheduling export — Locked Room (bottle episode).
     8 scenes, ALL in the same single location (HOTEL SUITE 412),
     all INT/NIGHT, 3-cast ensemble.
     Tests: stripboard with location repeated 8 times, all-NIGHT shoot,
     long-form dialogue scenes (3-4.5 pages), one no-cast cutaway insert.
     ============================================================================= -->
<BreakdownBook title="Locked Room" production="SceneIQ Demo Productions">

  <BreakdownSheet>
    <SceneNumber>1</SceneNumber>
    <Description>Long dialogue; tripod two-shot then singles</Description>
    <SceneHeading>INT. HOTEL SUITE 412 - NIGHT</SceneHeading>
    <SetName>HOTEL SUITE 412</SetName>
    <PageCount>3.0</PageCount>
    <ElementList>ALVAREZ, GREENE</ElementList>
    <ShootDay>New Mexico</ShootDay>
    <ProductionNote>Hold the master</ProductionNote>
  </BreakdownSheet>

  <BreakdownSheet>
    <SceneNumber>2</SceneNumber>
    <Description>Camera moves in 6 inches every minute</Description>
    <SceneHeading>INT. HOTEL SUITE 412 - NIGHT</SceneHeading>
    <SetName>HOTEL SUITE 412</SetName>
    <PageCount>2.25</PageCount>
    <ElementList>ALVAREZ, GREENE</ElementList>
    <ShootDay>New Mexico</ShootDay>
    <ProductionNote>Slow push</ProductionNote>
  </BreakdownSheet>

  <BreakdownSheet>
    <SceneNumber>3</SceneNumber>
    <Description>Solo beat — Alvarez on the phone</Description>
    <SceneHeading>INT. HOTEL SUITE 412 - NIGHT</SceneHeading>
    <SetName>HOTEL SUITE 412</SetName>
    <PageCount>0.5</PageCount>
    <ElementList>ALVAREZ</ElementList>
    <ShootDay>New Mexico</ShootDay>
    <ProductionNote>Profile only</ProductionNote>
  </BreakdownSheet>

  <BreakdownSheet>
    <SceneNumber>4</SceneNumber>
    <Description>Three-hander; door knock cold open</Description>
    <SceneHeading>INT. HOTEL SUITE 412 - NIGHT</SceneHeading>
    <SetName>HOTEL SUITE 412</SetName>
    <PageCount>4.5</PageCount>
    <ElementList>ALVAREZ, GREENE, WEBB</ElementList>
    <ShootDay>New Mexico</ShootDay>
    <ProductionNote>Wide three-shot first</ProductionNote>
  </BreakdownSheet>

  <BreakdownSheet>
    <SceneNumber>5</SceneNumber>
    <Description>Whispers across the room</Description>
    <SceneHeading>INT. HOTEL SUITE 412 - NIGHT</SceneHeading>
    <SetName>HOTEL SUITE 412</SetName>
    <PageCount>1.75</PageCount>
    <ElementList>GREENE, WEBB</ElementList>
    <ShootDay>New Mexico</ShootDay>
    <ProductionNote>Telephoto</ProductionNote>
  </BreakdownSheet>

  <BreakdownSheet>
    <SceneNumber>6</SceneNumber>
    <Description>Two attorneys talking shop</Description>
    <SceneHeading>INT. HOTEL SUITE 412 - NIGHT</SceneHeading>
    <SetName>HOTEL SUITE 412</SetName>
    <PageCount>2.0</PageCount>
    <ElementList>ALVAREZ, WEBB</ElementList>
    <ShootDay>New Mexico</ShootDay>
    <ProductionNote>Reverse setup</ProductionNote>
  </BreakdownSheet>

  <BreakdownSheet>
    <SceneNumber>7</SceneNumber>
    <Description>Cutaways; clock; cold coffee; ashtray</Description>
    <SceneHeading>INT. HOTEL SUITE 412 - NIGHT</SceneHeading>
    <SetName>HOTEL SUITE 412</SetName>
    <PageCount>0.25</PageCount>
    <ElementList></ElementList>
    <ShootDay>New Mexico</ShootDay>
    <ProductionNote>Static inserts</ProductionNote>
  </BreakdownSheet>

  <BreakdownSheet>
    <SceneNumber>8</SceneNumber>
    <Description>Climax; Greene confesses; long take</Description>
    <SceneHeading>INT. HOTEL SUITE 412 - NIGHT</SceneHeading>
    <SetName>HOTEL SUITE 412</SetName>
    <PageCount>3.75</PageCount>
    <ElementList>ALVAREZ, GREENE, WEBB</ElementList>
    <ShootDay>New Mexico</ShootDay>
    <ProductionNote>Single 180 lap</ProductionNote>
  </BreakdownSheet>

</BreakdownBook>
