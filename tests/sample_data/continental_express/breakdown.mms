    <SceneHeading>EXT. RAIL YARDS - NIGHT</SceneHeading>
    <SetName>RAIL YARDS</SetName>
    <PageCount>0.125</PageCount>
    <ElementList></ElementList>
    <ShootDay>New Mexico</ShootDay>
    <ProductionNote>Long lens, locked</ProductionNote>
