    <SceneHeading>EXT. GA RAIL CROSSING - DAY</SceneHeading>
    <SetName>GA RAIL CROSSING</SetName>
    <PageCount>0.5</PageCount>
    <ElementList></ElementList>
    <ShootDay>Georgia</ShootDay>
    <ProductionNote>Long lens, no cast</ProductionNote>
  </BreakdownSheet>

  <BreakdownSheet>
    <SceneNumber>5</SceneNumber>
    <Description>Three-shot; tight quarters</Description>
    <SceneHeading>INT. SLEEPER COMPARTMENT - NIGHT</SceneHeading>
    <SetName>SLEEPER COMPARTMENT</SetName>
    <PageCount>3.0</PageCount>
    <ElementList>TORRES, COLE, REED</ElementList>
    <ShootDay>Georgia</ShootDay>
