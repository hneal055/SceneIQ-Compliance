    <Description>Dawn light; quick handoff</Description>
    <SceneHeading>EXT. NEW ORLEANS STATION - DAWN</SceneHeading>
    <SetName>NEW ORLEANS STATION</SetName>
    <PageCount>1.0</PageCount>
    <ElementList>TORRES, DR. SOLOMON</ElementList>
