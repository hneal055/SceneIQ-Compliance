<?xml version="1.0" encoding="UTF-8"?>
<!-- =============================================================================
     tests/sample_data/continental_express/breakdown.mms
     Sample Movie Magic Scheduling export — Continental Express (multi-state action).
     15 scenes spanning Georgia → Louisiana → New Mexico (5/5/5 split).
     Tests: Jurisdiction Tracker with 3 rows + compliance push spanning
     states + DAWN/DUSK/DAY/NIGHT mix + 2 no-cast B-roll scenes.
     ============================================================================= -->
<BreakdownBook title="Continental Express" production="SceneIQ Demo Productions">

  <BreakdownSheet>
    <SceneNumber>1</SceneNumber>
    <Description>Opening; establish the team</Description>
    <SceneHeading>EXT. ATLANTA UNION STATION - DAY</SceneHeading>
    <SetName>ATLANTA UNION STATION</SetName>
    <PageCount>1.5</PageCount>
    <ElementList>TORRES, COLE, REED</ElementList>
    <ShootDay>Georgia</ShootDay>
    <ProductionNote>Wide platform crane</ProductionNote>
  </BreakdownSheet>

  <BreakdownSheet>
    <SceneNumber>2</SceneNumber>
    <Description>Tight two-shot; folder hand-off</Description>
    <SceneHeading>INT. CARRIAGE 7 - DAY</SceneHeading>
    <SetName>CARRIAGE 7</SetName>
    <PageCount>2.25</PageCount>
    <ElementList>TORRES, COLE</ElementList>
    <ShootDay>Georgia</ShootDay>
    <ProductionNote>Steadicam</ProductionNote>
  </BreakdownSheet>

  <BreakdownSheet>
    <SceneNumber>3</SceneNumber>
    <Description>Reed plays a passenger</Description>
    <SceneHeading>INT. DINING CAR - DAY</SceneHeading>
    <SetName>DINING CAR</SetName>
    <PageCount>1.75</PageCount>
    <ElementList>REED, CONDUCTOR BENNETT</ElementList>
    <ShootDay>Georgia</ShootDay>
    <ProductionNote>Profile coverage</ProductionNote>
  </BreakdownSheet>

  <BreakdownSheet>
    <SceneNumber>4</SceneNumber>
